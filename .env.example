# ---------------------------------------------------------------------------
# Finance OS - environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase, Neon, Railway, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/finance_os"

# ---- Auth (better-auth) ----------------------------------------------------
# Generate with: openssl rand -base64 32   (must be >= 32 chars)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# The public origin of the deployed app. REQUIRED in production or sign-in
# redirects and cookies break. Local dev can leave the default.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: same value is also read as the public app URL if set.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: extra allowed origins, comma-separated (e.g. preview deploys).
# BETTER_AUTH_TRUSTED_ORIGINS="https://finance-os.vercel.app,https://preview.vercel.app"

# ---- AI --------------------------------------------------------------------
# The advisor uses an OpenAI-compatible API. Set ONE provider key. Provider is
# auto-detected: OpenRouter > DeepSeek > OpenAI. Force one with AI_PROVIDER.

# DeepSeek (default). Key from https://platform.deepseek.com.
DEEPSEEK_API_KEY=""

# OpenRouter - one key, any model. Set per-key credit limits on their dashboard
# (https://openrouter.ai/settings/keys) for a hard account-level spend cap.
OPENROUTER_API_KEY=""

# OpenAI (fallback).
OPENAI_API_KEY=""

# Optional: force a provider ("deepseek" | "openrouter" | "openai").
# AI_PROVIDER="deepseek"
# Optional: override the model (e.g. "deepseek/deepseek-chat" on OpenRouter).
# AI_MODEL=""

# ---- AI cost safeguards ----------------------------------------------------
# Hard caps applied to every AI call. Defaults are safe; tune if needed.
AI_MAX_OUTPUT_TOKENS="800"   # max tokens the model can return per call
AI_MAX_INPUT_CHARS="2000"    # user message is truncated to this length
AI_TEMPERATURE="0.7"

# ---- Farcaster (creator wedge) ---------------------------------------------
# Neynar API key - used to pull the user's Farcaster creator signals.
# Free key at https://neynar.com. Optional until the Farcaster feature ships.
NEYNAR_API_KEY=""
